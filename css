@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #f5f6fc;
    --surface: #ffffff;
    --text: #20213b;
    --muted: #85869e;
    --primary: #6755e8;
    --primary-dark: #5040ce;
    --border: #e9e9f2;
    --green: #20a779;
    --orange: #f0a34a;
    --shadow: 0 12px 40px rgba(42, 39, 95, 0.06);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
}

a {
    color: inherit;
    text-decoration: none;
}

button, input {
    font: inherit;
}

h1, h2, h3, p {
    margin-top: 0;
}

h1, h2, h3, .brand {
    font-family: 'Manrope', sans-serif;
}

.muted {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.eyebrow {
    color: var(--primary);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 19px;
    white-space: nowrap;
}

.brand-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    color: white;
    background: linear-gradient(135deg, #8473ff, #5a45dd);
    box-shadow: 0 7px 18px #6755e840;
}

/* Login */

.login-page {
    min-height: 100vh;
    background: white;
}

.login-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
}

.login-art {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 48px 8%;
    overflow: hidden;
    color: white;
    background:
        radial-gradient(circle at 80% 20%, #8272ff77, transparent 30%),
        radial-gradient(circle at 15% 90%, #df5c9c44, transparent 35%),
        linear-gradient(145deg, #211d54, #393078 55%, #5440a0);
}

.login-art .brand-icon {
    color: #5c4bce;
    background: white;
}

.art-content {
    position: relative;
    z-index: 1;
    max-width: 520px;
}

.art-content .eyebrow {
    color: #c5bcff;
}

.art-content h1 {
    margin: 22px 0;
    font-size: clamp(38px, 4.5vw, 62px);
    line-height: 1.12;
    letter-spacing: -2.5px;
}

.art-content p {
    max-width: 390px;
    color: #d4d0f2;
    font-size: 15px;
    line-height: 1.9;
}

.food-orbit {
    margin-top: 42px;
    padding: 20px;
    border: 1px solid #ffffff30;
    border-radius: 18px;
    background: #ffffff0b;
    font-size: 35px;
    letter-spacing: 12px;
    backdrop-filter: blur(12px);
}

.copyright {
    color: #b7b0e5;
    font-size: 10px;
    letter-spacing: 1.5px;
}

.login-panel {
    display: grid;
    place-items: center;
    padding: 40px 24px;
}

.login-card {
    width: 100%;
    max-width: 400px;
}

.mobile-brand {
    display: none;
    margin-bottom: 42px;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 20px;
}

.login-card h2 {
    margin: 13px 0 8px;
    font-size: 30px;
    letter-spacing: -1px;
}

.login-card form {
    display: grid;
    margin-top: 30px;
}

.login-card label {
    margin: 18px 0 9px;
    font-size: 12px;
    font-weight: 700;
}

.login-card input {
    width: 100%;
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
    background: #fbfbfe;
    transition: .2s;
}

.login-card input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px #6755e817;
}

.login-note {
    margin-top: 25px;
    text-align: center;
    color: var(--muted);
    font-size: 11px;
}

/* Shared buttons and alerts */

.primary-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    margin-top: 22px;
    padding: 15px 18px;
    border: 0;
    border-radius: 10px;
    color: white;
    background: linear-gradient(100deg, var(--primary), #8873f5);
    font-weight: 700;
    cursor: pointer;
    transition: transform .2s, box-shadow .2s;
}

.primary-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 22px #6755e83b;
}

.primary-button:disabled {
    opacity: .5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.primary-button span {
    font-size: 19px;
}

.alert {
    margin: 14px 0;
    padding: 13px 16px;
    border-radius: 9px;
    font-size: 13px;
}

.alert.error {
    color: #a12b43;
    border: 1px solid #f7c9d2;
    background: #fff0f3;
}

/* Dashboard */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: 245px;
    padding: 28px 18px 18px;
    background: var(--surface);
    border-right: 1px solid var(--border);
}

.sidebar .brand {
    padding: 0 8px;
    font-size: 17px;
}

.nav-label {
    margin: 48px 12px 14px;
    color: #a1a1b5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 4px 0;
    padding: 13px 14px;
    border-radius: 10px;
    color: #777890;
    font-size: 13px;
    transition: .2s;
}

.nav-link span {
    width: 20px;
    text-align: center;
    font-size: 17px;
}

.nav-link:hover,
.nav-link.active {
    color: var(--primary);
    background: #f0edff;
    font-weight: 700;
}

.sidebar-bottom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 15px 4px 4px;
    border-top: 1px solid var(--border);
}

.profile-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: white;
    background: linear-gradient(135deg, #8875ff, #5141c8);
    font-weight: 800;
}

.profile-details {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.profile-details strong {
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
}

.profile-details span {
    color: var(--muted);
    font-size: 10px;
}

.logout-link {
    margin-left: auto;
    color: var(--muted);
    font-size: 19px;
}

.main-content {
    max-width: 1700px;
    margin-left: 245px;
    padding: 36px clamp(22px, 4vw, 58px);
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 27px;
}

.breadcrumb {
    margin-bottom: 13px;
    color: var(--muted);
    font-size: 11px;
}

.topbar h1 {
    margin-bottom: 7px;
    font-size: clamp(23px, 2.4vw, 31px);
    letter-spacing: -1px;
}

.status-pill {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    padding: 11px 15px;
    border: 1px solid var(--border);
    border-radius: 25px;
    background: white;
    color: #686980;
    font-size: 11px;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px #20a77917;
}

.welcome-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 185px;
    padding: 30px 36px;
    overflow: hidden;
    border-radius: 19px;
    color: white;
    background:
        radial-gradient(circle at 90% 10%, #ffffff25, transparent 24%),
        linear-gradient(110deg, #4f40bd, #7866e8 70%, #9b83f4);
    box-shadow: 0 12px 28px #6755e823;
}

.welcome-banner .eyebrow {
    color: #d9d2ff;
}

.welcome-banner h2 {
    margin: 12px 0 8px;
    font-size: clamp(20px, 2.5vw, 28px);
    letter-spacing: -.7px;
}

.welcome-banner p {
    max-width: 490px;
    margin-bottom: 0;
    color: #e6e1ff;
    font-size: 12px;
    line-height: 1.7;
}

.banner-art {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    margin: 0 3% 0 20px;
    border: 1px solid #ffffff35;
    border-radius: 28px;
    background: #ffffff1a;
    font-size: 55px;
    transform: rotate(7deg);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 23px 0;
}

.stat-card,
.panel {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--surface);
    box-shadow: var(--shadow);
}

.stat-card {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    column-gap: 12px;
    padding: 20px;
}

.stat-icon {
    display: grid;
    grid-row: span 3;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    font-size: 20px;
}

.stat-icon.purple {
    color: #6755e8;
    background: #f0edff;
}

.stat-icon.orange {
    color: #d7862d;
    background: #fff3e5;
}

.stat-icon.green {
    color: #16966b;
    background: #e7f8f1;
}

.stat-card > span {
    color: var(--muted);
    font-size: 11px;
}

.stat-card strong {
    margin: 5px 0;
    overflow-wrap: anywhere;
    font-size: 19px;
}

.stat-card small {
    color: #a1a1b5;
    font-size: 10px;
}

.workspace-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 20px;
}

.panel {
    padding: 24px;
}

.panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px;
}

.panel-heading h2 {
    margin: 7px 0 0;
    font-size: 17px;
}

.panel-number {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: var(--primary);
    background: #f0edff;
    font-size: 12px;
    font-weight: 800;
}

.drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 245px;
    padding: 22px;
    border: 1.5px dashed #d3cffa;
    border-radius: 13px;
    background: #fbfaff;
    text-align: center;
    cursor: pointer;
    transition: .2s;
}

.drop-zone:hover {
    border-color: var(--primary);
    background: #f7f5ff;
}

.upload-symbol {
    display: grid;
    place-items: center;
    width: 47px;
    height: 47px;
    margin-bottom: 15px;
    border-radius: 14px;
    color: var(--primary);
    background: #efecff;
    font-size: 25px;
}

.drop-zone h3 {
    margin: 0 0 8px;
    font-size: 14px;
}

.drop-zone p {
    color: var(--muted);
    font-size: 11px;
}

.drop-zone input {
    display: none;
}

.choose-button {
    padding: 9px 15px;
    border: 1px solid #ddd7ff;
    border-radius: 8px;
    color: var(--primary);
    background: white;
    font-size: 11px;
    font-weight: 700;
}

.file-name {
    max-width: 100%;
    margin-top: 13px;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 11px;
}

.preview-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 25px;
    border-radius: 12px;
    background:
        radial-gradient(circle at 50% 40%, #f0edff, transparent 60%),
        #fafaff;
    text-align: center;
}

.preview-emoji {
    margin-bottom: 16px;
    font-size: 54px;
}

.preview-placeholder h3 {
    margin-bottom: 7px;
    font-size: 14px;
}

.preview-placeholder p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 11px;
}

.preview-image {
    display: block;
    width: 100%;
    height: 300px;
    border-radius: 12px;
    background: #f4f3fa;
    object-fit: contain;
}

.results-panel {
    margin-top: 20px;
}

.result-badge {
    padding: 8px 12px;
    border-radius: 20px;
    color: #6b5bd6;
    background: #f0edff;
    font-size: 10px;
    font-weight: 700;
}

.result-summary {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px;
    border: 1px solid #efedf8;
    border-radius: 13px;
    background: #fbfaff;
}

.result-food-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: #f0edff;
    font-size: 25px;
}

.result-main {
    min-width: 0;
}

.result-main .muted {
    font-size: 11px;
}

.result-main h3 {
    margin: 5px 0 0;
    overflow-wrap: anywhere;
    font-size: 20px;
}

.confidence-box {
    display: grid;
    gap: 5px;
    margin-left: auto;
    text-align: right;
}

.confidence-box span {
    color: var(--muted);
    font-size: 10px;
}

.confidence-box strong {
    color: var(--primary);
    font-size: 22px;
}

.subheading {
    margin: 25px 0 16px;
    font-size: 13px;
}

.prediction-list {
    display: grid;
    gap: 17px;
}

.prediction-row {
    display: grid;
    grid-template-columns: minmax(90px, 140px) minmax(40px, 1fr) 65px;
    align-items: center;
    gap: 13px;
    font-size: 11px;
}

.prediction-row > span {
    overflow-wrap: anywhere;
}

.prediction-row strong {
    text-align: right;
    font-size: 11px;
}

.bar-track {
    height: 7px;
    overflow: hidden;
    border-radius: 10px;
    background: #efedf7;
}

.bar-fill {
    height: 100%;
    min-width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #6956e8, #aa9bff);
}

.disclaimer {
    margin: 22px 0 0;
    color: #9696aa;
    font-size: 10px;
    line-height: 1.7;
}

.empty-results {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 28px 20px;
    border-radius: 12px;
    background: #fafaff;
}

.empty-results span {
    color: #8270ef;
    font-size: 28px;
}

.empty-results p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
}

.footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 30px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    color: #a1a1b5;
    font-size: 10px;
}

/* Responsive layout */

@media (max-width: 1050px) {
    .sidebar {
        width: 205px;
    }

    .main-content {
        margin-left: 205px;
        padding: 28px 22px;
    }

    .stats-grid {
        gap: 12px;
    }

    .stat-card {
        padding: 14px;
    }

    .workspace-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 720px) {
    .login-layout {
        grid-template-columns: 1fr;
    }

    .login-art {
        display: none;
    }

    .mobile-brand {
        display: block;
    }

    .login-panel {
        min-height: 100vh;
        padding: 30px 22px;
    }

    .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 15px 18px;
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .sidebar .brand {
        font-size: 16px;
    }

    .nav-label,
    .nav-link,
    .sidebar-bottom {
        display: none;
    }

    .main-content {
        margin-left: 0;
        padding: 23px 15px;
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .status-pill {
        align-self: flex-start;
    }

    .welcome-banner {
        min-height: 165px;
        padding: 23px;
    }

    .banner-art {
        width: 64px;
        height: 64px;
        margin-left: 10px;
        border-radius: 18px;
        font-size: 34px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .stat-card {
        padding: 17px;
    }

    .panel {
        padding: 18px;
    }

    .result-summary {
        flex-wrap: wrap;
    }

    .confidence-box {
        width: 100%;
        margin-left: 65px;
        text-align: left;
    }

    .prediction-row {
        grid-template-columns: 85px minmax(30px, 1fr) 55px;
        gap: 8px;
    }

    .footer {
        flex-direction: column;
    }
}